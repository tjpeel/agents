#!/usr/bin/env bash
# Remove this repository's installed agent symlinks for one explicit prefix.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: uninstall-agents --runtime codex|claude --prefix PREFIX [--check | --uninstall] [TARGET_DIRECTORY]

Modes:
  --check      Report this repository's installed and missing symlinks.
  --uninstall  Remove this repository's installed symlinks for PREFIX.

Only the exact agent names generated from this repository's current profile
folders are removed. For example, --prefix tjpeel removes tjpeel-read-low,
not another repository's tjpeel-ee-read-low. TARGET_DIRECTORY defaults to
~/.codex/agents or ~/.claude/agents for the current user. A literal ~ or ~/
path is resolved against the current user's home directory.

EOF
}

MODE="--uninstall"
RUNTIME=""
PREFIX=""
TARGET_DIRECTORY=""
target_given=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime|--prefix)
      [[ $# -ge 2 ]] || { echo "$1 requires a value." >&2; exit 2; }
      if [[ "$1" == "--runtime" ]]; then RUNTIME="$2"; else PREFIX="$2"; fi
      shift 2
      ;;
    --check|--uninstall)
      MODE="$1"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      [[ "$target_given" == false ]] || { echo "Only one target directory may be supplied." >&2; exit 2; }
      TARGET_DIRECTORY="$1"
      target_given=true
      shift
      ;;
  esac
done

[[ "$RUNTIME" == "codex" || "$RUNTIME" == "claude" ]] || { echo "--runtime must be codex or claude." >&2; exit 2; }
[[ -n "$PREFIX" ]] || { echo "--prefix is required." >&2; usage >&2; exit 2; }
[[ "$PREFIX" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "PREFIX must start with a lowercase letter or number and use only lowercase letters, numbers, or hyphens." >&2; exit 2; }

if [[ "$target_given" == false ]]; then
  if [[ "$RUNTIME" == "codex" ]]; then TARGET_DIRECTORY="$HOME/.codex/agents"; else TARGET_DIRECTORY="$HOME/.claude/agents"; fi
fi
case "$TARGET_DIRECTORY" in
  '~') TARGET_DIRECTORY="$HOME" ;;
  '~/'*) TARGET_DIRECTORY="$HOME/${TARGET_DIRECTORY:2}" ;;
esac
[[ "$TARGET_DIRECTORY" == /* ]] || { echo "TARGET_DIRECTORY must be absolute or begin with ~/: $TARGET_DIRECTORY" >&2; exit 2; }

SCRIPT_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REPOSITORY_DIRECTORY="$(CDPATH= cd -- "$SCRIPT_DIRECTORY/.." && pwd -P)"
if [[ "$RUNTIME" == "codex" ]]; then EXTENSION="toml"; else EXTENSION="md"; fi

agent_directories=()
shopt -s nullglob
for agent_directory in "$REPOSITORY_DIRECTORY"/*/; do
  [[ "$(basename -- "$agent_directory")" == "scripts" ]] && continue
  [[ -f "${agent_directory%/}/$RUNTIME/agent.$EXTENSION" ]] && agent_directories+=("$(basename -- "$agent_directory")")
done
[[ ${#agent_directories[@]} -gt 0 ]] || { echo "No $RUNTIME definitions found under: $REPOSITORY_DIRECTORY" >&2; exit 1; }

status=0
for agent_directory in "${agent_directories[@]}"; do
  installed_name="$PREFIX-$agent_directory"
  destination="$TARGET_DIRECTORY/$installed_name.$EXTENSION"
  agent_file="$REPOSITORY_DIRECTORY/$agent_directory/$RUNTIME/agent.$EXTENSION"
  if [[ -L "$destination" && "$(readlink "$destination")" == "$agent_file" ]]; then
    if [[ "$MODE" == "--check" ]]; then
      echo "installed  $installed_name"
    else
      rm -f -- "$destination"
      echo "uninstalled  $installed_name"
    fi
  elif [[ -e "$destination" || -L "$destination" ]]; then
    echo "conflict   $installed_name -> $(readlink "$destination" 2>/dev/null || echo 'not this repository link')"
    status=1
  else
    echo "missing    $installed_name"
    status=1
  fi
done

if [[ "$MODE" == "--check" ]]; then exit "$status"; fi
