#!/usr/bin/env bash
# Install the selected runtime's custom-agent definitions as owned regular files.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: install-agents --runtime codex|claude --prefix PREFIX [--check | --install | --refresh] [TARGET_DIRECTORY]

Modes:
  --check    Report current, stale, legacy, missing, and conflicting definitions.
  --install  Add missing definitions and leave every existing path untouched.
  --refresh  Update unchanged owned copies and migrate this repository's links.

Each direct child of the repository is an agent folder. Install Codex from
<agent>/codex/agent.toml or Claude from <agent>/claude/agent.md. PREFIX is
included in the installed filename: for example, --prefix tjpeel installs
read-low as tjpeel-read-low. Definitions are copied with ownership comments; their
declared agent names remain stable. TARGET_DIRECTORY defaults to ~/.codex/agents
or ~/.claude/agents for the current user. A literal ~ or ~/ path is resolved
against the current user's home directory.

EOF
}

MODE="--install"
RUNTIME=""
PREFIX=""
TARGET_DIRECTORY=""
target_given=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime|--prefix)
      if [[ $# -lt 2 ]]; then
        echo "$1 requires a value." >&2
        exit 2
      fi
      if [[ "$1" == "--runtime" ]]; then
        RUNTIME="$2"
      elif [[ "$1" == "--prefix" ]]; then
        PREFIX="$2"
      fi
      shift 2
      ;;
    --check|--install|--refresh)
      MODE="$1"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ "$target_given" == true ]]; then
        echo "Only one target directory may be supplied." >&2
        usage >&2
        exit 2
      fi
      TARGET_DIRECTORY="$1"
      target_given=true
      shift
      ;;
  esac
done

if [[ "$RUNTIME" != "codex" && "$RUNTIME" != "claude" ]]; then
  echo "--runtime must be codex or claude." >&2
  exit 2
fi
if [[ -z "$PREFIX" ]]; then
  echo "--prefix is required." >&2
  exit 2
fi
if [[ ! "$PREFIX" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "PREFIX must start with a lowercase letter or number and use only lowercase letters, numbers, or hyphens." >&2
  exit 2
fi

if [[ "$target_given" == false ]]; then
  if [[ "$RUNTIME" == "codex" ]]; then TARGET_DIRECTORY="${CODEX_HOME:-$HOME/.codex}/agents"; else TARGET_DIRECTORY="$HOME/.claude/agents"; fi
fi
case "$TARGET_DIRECTORY" in
  '~') TARGET_DIRECTORY="$HOME" ;;
  '~/'*) TARGET_DIRECTORY="$HOME/${TARGET_DIRECTORY:2}" ;;
esac
if [[ "$TARGET_DIRECTORY" != /* ]]; then
  echo "TARGET_DIRECTORY must be absolute or begin with ~/: $TARGET_DIRECTORY" >&2
  exit 2
fi

SCRIPT_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REPOSITORY_DIRECTORY="$(CDPATH= cd -- "$SCRIPT_DIRECTORY/.." && pwd -P)"
source "$SCRIPT_DIRECTORY/agent-installation-lib.sh"
load_catalogue_identity
if [[ "$RUNTIME" == "codex" ]]; then EXTENSION="toml"; else EXTENSION="md"; fi

if [[ ! -d "$TARGET_DIRECTORY" ]]; then
  if [[ "$MODE" == "--check" ]]; then
    echo "Target directory does not exist: $TARGET_DIRECTORY" >&2
    exit 1
  fi
  mkdir -p -- "$TARGET_DIRECTORY"
fi

agent_files=()
shopt -s nullglob
for agent_directory in "$REPOSITORY_DIRECTORY"/*/; do
  [[ "$(basename -- "$agent_directory")" == "scripts" ]] && continue
  candidate="${agent_directory%/}/$RUNTIME/agent.$EXTENSION"
  [[ -f "$candidate" ]] && agent_files+=("$candidate")
done
if [[ ${#agent_files[@]} -eq 0 ]]; then
  echo "No $RUNTIME definitions found under: $REPOSITORY_DIRECTORY" >&2
  exit 1
fi

for agent_file in "${agent_files[@]}"; do
  if rg -q '^# personal-agents-(catalogue|source|checksum): ' "$agent_file"; then
    echo "Source definition contains reserved ownership comments: $agent_file" >&2
    exit 1
  fi
  if [[ "$RUNTIME" == "codex" ]]; then
    valid=$(rg -c '^(name|description|developer_instructions)\s*=' "$agent_file" || true)
    [[ "$valid" -eq 3 ]] || { echo "Invalid Codex definition: $agent_file" >&2; exit 1; }
  else
    [[ "$(head -n 1 "$agent_file")" == "---" ]] && rg -q '^name:' "$agent_file" && rg -q '^description:' "$agent_file" || { echo "Invalid Claude definition: $agent_file" >&2; exit 1; }
  fi
done

installed_name_for() {
  local agent_file="$1"
  local agent_directory
  agent_directory="$(basename -- "$(dirname -- "$(dirname -- "$agent_file")")")"
  printf '%s-%s' "$PREFIX" "$agent_directory"
}

destination_for() {
  local agent_file="$1"
  printf '%s/%s.%s' "$TARGET_DIRECTORY" "$(installed_name_for "$agent_file")" "$EXTENSION"
}

status=0
for agent_file in "${agent_files[@]}"; do
  installed_name="$(installed_name_for "$agent_file")"
  destination="$(destination_for "$agent_file")"

  if is_current_copy "$destination" "$agent_file"; then
    echo "installed  $installed_name"
  elif is_owned_link "$destination" "$agent_file" || is_owned_copy "$destination" "$agent_file"; then
    if [[ "$MODE" == "--refresh" ]]; then
      write_definition "$agent_file" "$destination"
      echo "refreshed  $installed_name"
    else
      if is_owned_link "$destination" "$agent_file"; then state="legacy"; else state="stale"; fi
      echo "$state  $installed_name (use --refresh)"
      status=1
    fi
  elif [[ -e "$destination" || -L "$destination" ]]; then
    echo "conflict   $installed_name (unowned or locally changed definition)" >&2
    status=1
  elif [[ "$MODE" == "--check" ]]; then
    echo "missing    $installed_name"
    status=1
  else
    write_definition "$agent_file" "$destination"
    echo "installed  $installed_name"
  fi
done
exit "$status"
