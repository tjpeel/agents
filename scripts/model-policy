#!/usr/bin/env python3
"""Select and render offline native profiles from the canonical model policy."""
import argparse
import json
from pathlib import Path
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
BANDS = ("low", "medium", "high", "xhigh", "max")
MODELS = {"codex": {"gpt-6.1-sol"}, "claude": {"claude-sonnet-5-5", "claude-opus-5-5"}, "opencode": {"synthetic/hf:moonshotai/Kimi-K3"}}
TOOLS = {"read": ["Read", "Glob", "Grep"], "write": ["Read", "Glob", "Grep", "Edit", "Write", "Bash"]}


def load_policy(path):
    policy = json.loads(path.read_text())
    if set(policy) != {"schema_version", "default_band", "default_speed", "bands", "runtimes", "access", "aliases"}:
        raise ValueError("unknown or missing policy fields")
    if policy["schema_version"] != 1 or policy["bands"] != list(BANDS):
        raise ValueError("unsupported schema or bands")
    if policy["default_band"] != "low" or policy["default_speed"] != "standard":
        raise ValueError("defaults must be low and standard")
    if set(policy["runtimes"]) != set(MODELS) or set(policy["access"]) != set(TOOLS):
        raise ValueError("unsupported runtime or access boundary")
    for runtime, adapter in policy["runtimes"].items():
        if set(adapter) != {"models", "overrides"} or set(adapter["models"]) != set(BANDS):
            raise ValueError(f"incomplete {runtime} model adapter")
        if any(model not in MODELS[runtime] for model in adapter["models"].values()):
            raise ValueError(f"unsupported {runtime} model")
        expected_overrides = {} if runtime in ("codex", "opencode") else {"sonnet": "claude-sonnet-5-5", "opus": "claude-opus-5-5"}
        if adapter["overrides"] != expected_overrides:
            raise ValueError(f"unsupported {runtime} model overrides")
    for access, boundary in policy["access"].items():
        sandbox = "read-only" if access == "read" else "workspace-write"
        if (set(boundary) != {"codex_sandbox", "claude_tools", "instructions"}
                or boundary["codex_sandbox"] != sandbox or boundary["claude_tools"] != TOOLS[access]):
            raise ValueError(f"invalid {access} permissions")
        if not isinstance(boundary["instructions"], str) or not boundary["instructions"].strip():
            raise ValueError(f"missing {access} instructions")
    if policy["aliases"] != {"read_deep": "read_max", "read_exceptional": "read_xhigh"}:
        raise ValueError("legacy aliases must retain their access and band")
    return policy


def profiles(policy):
    result = {f"{access}_{band}": (access, band) for access in TOOLS for band in BANDS}
    for alias, target in policy["aliases"].items():
        result[alias] = result[target]
    return result


def selection(policy, runtime, access, band, model=None):
    adapter = policy["runtimes"][runtime]
    if model is not None and model not in adapter["overrides"]:
        raise ValueError(f"unsupported {runtime} model override: {model}")
    name = f"{access}_{model}_{band}" if model == "opus" else f"{access}_{band}"
    return {"profile": name, "model": adapter["overrides"][model] if model else adapter["models"][band],
            "effort": None if runtime == "opencode" else band, "access": access, "speed_intent": policy["default_speed"],
            **({"band": band} if runtime == "opencode" else {})}


def base_definitions(policy, runtime_filter=None, model_override=None):
    result = {}
    for name, (access, band) in profiles(policy).items():
        if model_override and name in policy["aliases"]:
            continue
        if model_override == "opus":
            name = f"{access}_{model_override}_{band}"
        boundary = policy["access"][access]
        for runtime in MODELS:
            if runtime_filter and runtime != runtime_filter:
                continue
            model = selection(policy, runtime, access, band, model_override)["model"]
            description = f"{model}, {band} effort for bounded {access} task; handoff defines its responsibility."
            if runtime == "codex":
                values = {"name": name, "description": description, "model": model,
                          "model_reasoning_effort": band, "sandbox_mode": boundary["codex_sandbox"],
                          "developer_instructions": boundary["instructions"]}
                content = "# Generated by scripts/model-policy; edit model-policy.json.\n"
                content += "".join(f"{key} = {json.dumps(value)}\n" for key, value in values.items())
                tomllib.loads(content)  # Validate before any writes.
                extension = "toml"
            elif runtime == "opencode":
                # Bands identify workload profiles, not a supported Kimi effort control.
                description = f"Kimi K3 for bounded {access} task ({band} workload); handoff defines responsibility."
                permissions = {"*": "deny", "read": "allow", "glob": "allow", "grep": "allow"}
                if access == "write":
                    permissions.update(edit="allow", bash="allow")
                content = f"---\ndescription: {description}\nmode: subagent\nmodel: {model}\npermission: {json.dumps(permissions)}\n---\n\n"
                content += "<!-- Generated by scripts/model-policy; edit model-policy.json. -->\n\n"
                content += boundary["instructions"] + "\n"
                extension = "md"
            else:
                content = f"---\nname: {name}\ndescription: {description}\ntools: {', '.join(boundary['claude_tools'])}\nmodel: {model}\neffort: {band}\n"
                if access == "write":
                    content += "permissionMode: default\n"
                content += "---\n\n<!-- Generated by scripts/model-policy; edit model-policy.json. -->\n\n"
                content += boundary["instructions"] + "\n"
                extension = "md"
            result[Path(name.replace("_", "-")) / runtime / f"agent.{extension}"] = content
    return result


def definitions(policy, runtime_filter=None, model_override=None):
    result = base_definitions(policy, runtime_filter, model_override)
    if model_override is None and runtime_filter in (None, "claude"):
        result.update(base_definitions(policy, "claude", "opus"))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--policy", type=Path, default=ROOT / "model-policy.json")
    sub = parser.add_subparsers(dest="command", required=True)
    select = sub.add_parser("select", help="resolve an already graded bounded task")
    select.add_argument("--runtime", choices=MODELS, required=True)
    select.add_argument("--access", choices=TOOLS, required=True)
    select.add_argument("--band", choices=BANDS, default="low")
    select.add_argument("--model", help="explicit provider model override, e.g. opus")
    for command in ("render", "check"):
        render = sub.add_parser(command)
        render.add_argument("--output", type=Path, default=ROOT)
        render.add_argument("--runtime", choices=MODELS)
        render.add_argument("--model", help="render distinct profiles for an explicit model override")
    args = parser.parse_args()
    try:
        policy = load_policy(args.policy)
        if args.command == "select":
            print(json.dumps(selection(policy, args.runtime, args.access, args.band, args.model)))
        else:
            if args.model and (not args.runtime or args.output.resolve() == ROOT):
                raise ValueError("model override rendering requires --runtime and a separate --output directory")
            expected = definitions(policy, args.runtime, args.model)
            if args.command == "check":
                stale = [str(path) for path, content in expected.items()
                         if not (args.output / path).is_file() or (args.output / path).read_text() != content]
                if stale:
                    raise ValueError("missing or stale definitions: " + ", ".join(stale))
                print(f"Validated {len(expected)} native definitions.")
            else:
                # Validate every target before touching existing definitions.
                for path in expected:
                    destination = args.output / path
                    candidates = [destination, *list(destination.parents)[:len(path.parts)]]
                    if any(candidate.is_symlink() for candidate in candidates):
                        raise ValueError(f"refusing to render through a symlink: {destination}")
                    if destination.exists() and not destination.is_file():
                        raise ValueError(f"definition target is not a file: {destination}")
                for path, content in expected.items():
                    destination = args.output / path
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    destination.write_text(content)
                print(f"Rendered {len(expected)} native definitions.")
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        parser.exit(1, f"Model policy error: {error}\n")


if __name__ == "__main__":
    main()
