#!/usr/bin/env python3
"""Offline checks for selection, native boundaries and reproducible generation."""
import json
import os
from pathlib import Path
import subprocess
import tempfile
import tomllib
import unittest

ROOT = Path(__file__).resolve().parent.parent
SCRIPT = ROOT / "scripts/model-policy"
BANDS = ("low", "medium", "high", "xhigh", "max")


class ModelPolicyTests(unittest.TestCase):
    def run_policy(self, *args, ok=True, env=None):
        result = subprocess.run([str(SCRIPT), *map(str, args)], text=True, capture_output=True, env=env)
        self.assertEqual(result.returncode == 0, ok, result.stderr or result.stdout)
        return result

    def test_default_and_all_explicit_bands_keep_provider_and_access(self):
        for runtime, model in (("codex", "gpt-6.1-sol"), ("claude", "claude-sonnet-5-5")):
            for access in ("read", "write"):
                default = json.loads(self.run_policy("select", "--runtime", runtime, "--access", access).stdout)
                self.assertEqual(default["profile"], f"{access}_low")
                for band in BANDS:
                    selected = json.loads(self.run_policy("select", "--runtime", runtime, "--access", access, "--band", band).stdout)
                    self.assertEqual(selected, {"profile": f"{access}_{band}", "model": model,
                                               "effort": band, "access": access, "speed_intent": "standard"})

    def test_render_check_boundaries_and_legacy_names(self):
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory)
            self.run_policy("render", "--output", target)
            self.run_policy("check", "--output", target)
            for access in ("read", "write"):
                for band in BANDS:
                    path = target / f"{access}-{band}"
                    codex = tomllib.loads((path / "codex/agent.toml").read_text())
                    self.assertEqual(codex["name"], f"{access}_{band}")
                    self.assertEqual(codex["model_reasoning_effort"], band)
                    self.assertEqual(codex["sandbox_mode"], "read-only" if access == "read" else "workspace-write")
                    claude = (path / "claude/agent.md").read_text()
                    header = dict(line.split(": ", 1) for line in claude.split("---", 2)[1].strip().splitlines())
                    self.assertEqual(header["name"], f"{access}_{band}")
                    self.assertEqual(header["effort"], band)
                    self.assertEqual(header["model"], "claude-sonnet-5-5")
                    self.assertEqual(header["tools"], "Read, Glob, Grep" if access == "read" else "Read, Glob, Grep, Edit, Write, Bash")
                    self.assertEqual("permissionMode" in header, access == "write")
            for alias, band in (("read-deep", "max"), ("read-exceptional", "xhigh")):
                codex = tomllib.loads((target / alias / "codex/agent.toml").read_text())
                self.assertEqual(codex["name"], alias.replace("-", "_"))
                self.assertEqual(codex["model_reasoning_effort"], band)
                self.assertEqual(codex["sandbox_mode"], "read-only")
            changed = target / "write-low/codex/agent.toml"
            changed.write_text(changed.read_text().replace('workspace-write', 'danger-full-access'))
            self.assertIn("write-low/codex/agent.toml", self.run_policy("check", "--output", target, ok=False).stderr)

    def test_blank_install_contains_both_models_at_every_effort(self):
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory)
            rendered = target / "catalogue"
            self.run_policy("render", "--output", rendered)
            self.assertEqual(len(list(rendered.glob("*/claude/agent.md"))), 22)
            self.assertEqual(len(list(rendered.glob("*/codex/agent.toml"))), 12)
            for access in ("read", "write"):
                for band in BANDS:
                    for family, model in (("sonnet", "claude-sonnet-5-5"), ("opus", "claude-opus-5-5")):
                        selected = json.loads(self.run_policy("select", "--runtime", "claude", "--access", access,
                                                              "--band", band, "--model", family).stdout)
                        profile = selected["profile"]
                        definition = rendered / profile.replace("_", "-") / "claude/agent.md"
                        header = dict(line.split(": ", 1) for line in definition.read_text().split("---", 2)[1].strip().splitlines())
                        self.assertEqual(header["name"], profile)
                        self.assertEqual(header["model"], model)
                        self.assertEqual(header["effort"], band)
                        self.assertEqual(selected["effort"], band)
                        self.assertEqual(header["tools"], "Read, Glob, Grep" if access == "read" else "Read, Glob, Grep, Edit, Write, Bash")
            for runtime, extension, count in (("claude", "md", 22), ("codex", "toml", 12)):
                installed = target / runtime
                command = [str(ROOT / "scripts/install-agents"), "--runtime", runtime, "--prefix", "sample", str(installed)]
                result = subprocess.run(command, text=True, capture_output=True)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(len(list(installed.glob(f"*.{extension}"))), count)
                if runtime == "claude":
                    for access in ("read", "write"):
                        for band in BANDS:
                            for suffix, model in (("", "claude-sonnet-5-5"), ("-opus", "claude-opus-5-5")):
                                content = (installed / f"sample-{access}{suffix}-{band}.md").read_text()
                                self.assertIn(f"model: {model}\n", content)
                                self.assertIn(f"effort: {band}\n", content)
                result = subprocess.run(command[:-1] + ["--check", str(installed)], text=True, capture_output=True)
                self.assertEqual(result.returncode, 0, result.stderr)

    def test_explicit_opus_is_separate_and_does_not_change_defaults(self):
        result = json.loads(self.run_policy("select", "--runtime", "claude", "--access", "read", "--band", "high", "--model", "opus").stdout)
        self.assertEqual(result["profile"], "read_opus_high")
        self.assertEqual(result["model"], "claude-opus-5-5")
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory)
            self.run_policy("render", "--runtime", "claude", "--model", "opus", "--output", target)
            self.run_policy("check", "--runtime", "claude", "--model", "opus", "--output", target)
            self.assertEqual(len(list(target.glob("*/claude/agent.md"))), 10)
            self.assertFalse(list(target.glob("*/codex/*")))
            self.assertIn("name: read_opus_high\n", (target / "read-opus-high/claude/agent.md").read_text())
        self.run_policy("render", "--runtime", "claude", "--model", "opus", ok=False)
        self.run_policy("select", "--runtime", "codex", "--access", "read", "--model", "opus", ok=False)

    def test_invalid_input_and_policy_fail_before_writes(self):
        for args in (("--runtime", "other", "--access", "read"), ("--runtime", "codex", "--access", "admin"),
                     ("--runtime", "codex", "--access", "read", "--band", "ultra"),
                     ("--runtime", "claude", "--access", "read", "--model", "fast")):
            self.run_policy("select", *args, ok=False)
        mutations = [lambda p: p.update(default_band="ultra"), lambda p: p.update(default_speed="fast"),
                     lambda p: p["runtimes"]["codex"]["models"].update(low="unsupported"),
                     lambda p: p["access"]["read"].update(claude_tools=["Read", "Write"]),
                     lambda p: p["aliases"].update(read_deep="write_max")]
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory) / "output"
            policy_file = Path(directory) / "invalid.json"
            for mutate in mutations:
                policy = json.loads((ROOT / "model-policy.json").read_text())
                mutate(policy)
                policy_file.write_text(json.dumps(policy))
                self.assertIn("Model policy error:", self.run_policy("--policy", policy_file, "render", "--output", target, ok=False).stderr)
                self.assertFalse(target.exists())

    def test_render_preserves_symlink_targets_and_reports_failed_writes(self):
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory) / "output"
            linked = target / "read-low/codex/agent.toml"
            linked.parent.mkdir(parents=True)
            external = Path(directory) / "preserved.toml"
            external.write_text("preserve me\n")
            linked.symlink_to(external)
            self.assertIn("symlink", self.run_policy("render", "--output", target, ok=False).stderr)
            self.assertEqual(external.read_text(), "preserve me\n")
            self.assertFalse((target / "read-medium").exists())
            blocked = Path(directory) / "blocked"
            blocked.write_text("not a directory\n")
            result = self.run_policy("render", "--output", blocked, ok=False)
            self.assertIn("Model policy error:", result.stderr)
            self.assertNotIn("Rendered", result.stdout)
            self.assertEqual(blocked.read_text(), "not a directory\n")

    def test_missing_python_fails_before_writes(self):
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory) / "output"
            env = dict(os.environ, PATH=directory)
            result = self.run_policy("render", "--output", target, env=env, ok=False)
            self.assertIn("python3", result.stderr)
            self.assertFalse(target.exists())

    def test_opencode_profiles_use_native_permissions_without_effort(self):
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory)
            self.run_policy("render", "--runtime", "opencode", "--output", target)
            self.assertEqual(len(list(target.glob("*/opencode/agent.md"))), 12)
            for access in ("read", "write"):
                for band in BANDS:
                    selected = json.loads(self.run_policy("select", "--runtime", "opencode", "--access", access, "--band", band).stdout)
                    self.assertIsNone(selected["effort"])
                    self.assertEqual(selected["band"], band)
                    self.assertEqual(selected["model"], "synthetic/hf:moonshotai/Kimi-K3")
                    content = (target / f"{access}-{band}/opencode/agent.md").read_text()
                    header = dict(line.split(": ", 1) for line in content.split("---", 2)[1].strip().splitlines())
                    self.assertEqual(header["mode"], "subagent")
                    self.assertNotIn("effort", header)
                    permissions = json.loads(header["permission"])
                    self.assertEqual(permissions["*"], "deny")
                    for tool in ("read", "glob", "grep"):
                        self.assertEqual(permissions[tool], "allow")
                    for tool in ("edit", "bash"):
                        self.assertEqual(permissions.get(tool, permissions["*"]), "allow" if access == "write" else "deny")
                    for tool in ("task", "webfetch", "skill", "external_directory"):
                        self.assertEqual(permissions.get(tool, permissions["*"]), "deny")

    def test_committed_profiles_are_current(self):
        self.run_policy("check")


if __name__ == "__main__":
    unittest.main()
